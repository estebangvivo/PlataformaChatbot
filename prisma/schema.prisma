generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  isSystem    Boolean  @default(false) @map("is_system")
  isAdmin     Boolean  @default(false) @map("is_admin")
  isDeskAgent Boolean  @default(true) @map("is_desk_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model DeskRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("desk_roles")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          String   @default("AGENT")
  roleId        String?  @map("role_id")
  fullName      String   @map("full_name")
  isOnline      Boolean  @default(false) @map("is_online")
  lastSeenAt    DateTime? @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")

  accessRole             Role?          @relation(fields: [roleId], references: [id])
  agentProfile           AgentProfile?
  assignedConversations  Conversation[] @relation("AssignedAgent")
  sentMessages           Message[]
  deskEventsAsActor      DeskEvent[]    @relation("DeskEventActor")
  deskEventsFrom         DeskEvent[]    @relation("DeskEventFrom")
  deskEventsTo           DeskEvent[]    @relation("DeskEventTo")
  teamMemberships        TeamThreadMember[]
  teamMessages           TeamChatMessage[]
  passwordResets         PasswordReset[]

  @@index([roleId])
  @@map("users")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model AgentProfile {
  id               String @id @default(cuid())
  userId           String @unique @map("user_id")
  department       String
  workHours        String @map("work_hours")
  assignedKeywords String @map("assigned_keywords")
  roundRobinIndex  Int    @default(0) @map("round_robin_index")
  lastAssignedAt   DateTime? @map("last_assigned_at")
  notifyPhone      String?   @unique @map("notify_phone")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model Conversation {
  id               String   @id @default(cuid())
  whatsappPhone    String   @unique @map("whatsapp_phone")
  userName         String?  @map("user_name")
  status           String   @default("BOT")
  assignedAgentId  String?  @map("assigned_agent_id")
  lastMessageAt    DateTime @default(now()) @map("last_message_at")
  lastIntent       String?  @map("last_intent")
  botEnabled       Boolean  @default(true) @map("bot_enabled")
  contactProfile   String?  @map("contact_profile")
  closedAt         DateTime? @map("closed_at")
  closeOutcome     String?  @map("close_outcome")
  channel          String    @default("whatsapp")
  firstBotReplyAt  DateTime? @map("first_bot_reply_at")
  firstHumanReplyAt DateTime? @map("first_human_reply_at")
  assignedAt       DateTime? @map("assigned_at")
  surveyStatus     String    @default("none") @map("survey_status")
  surveyScore      Int?      @map("survey_score")
  surveyComment    String?   @map("survey_comment")
  surveyedAt       DateTime? @map("surveyed_at")
  reopenCount      Int       @default(0) @map("reopen_count")
  createdAt        DateTime @default(now()) @map("created_at")

  assignedAgent User?      @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages      Message[]
  deskEvents    DeskEvent[]

  @@index([status])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderType     String   @map("sender_type")
  agentId        String?  @map("agent_id")
  content        String
  timestamp      DateTime @default(now())
  whatsappId     String?  @map("whatsapp_id")
  metadata       String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        User?        @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([conversationId, timestamp])
  @@map("messages")
}

model DeskEvent {
  id             String   @id @default(cuid())
  type           String
  conversationId String    @map("conversation_id")
  actorUserId    String?   @map("actor_user_id")
  fromAgentId    String?   @map("from_agent_id")
  toAgentId      String?   @map("to_agent_id")
  department     String?
  intent         String?
  outcome        String?
  note           String?
  source         String?
  metadata       String?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor          User?         @relation("DeskEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  fromAgent      User?         @relation("DeskEventFrom", fields: [fromAgentId], references: [id], onDelete: SetNull)
  toAgent        User?         @relation("DeskEventTo", fields: [toAgentId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([conversationId, createdAt])
  @@index([toAgentId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("desk_events")
}

model KnowledgeChunk {
  id           String   @id @default(cuid())
  pageUrl      String   @map("page_url")
  title        String?
  contentChunk String   @map("content_chunk")
  embedding    String?
  category     String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("knowledge_base")
}

model RoutingRule {
  id         String  @id @default(cuid())
  intent     String
  keywords   String
  department String
  priority   Int     @default(0)
  isActive   Boolean @default(true) @map("is_active")

  @@map("routing_rules")
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("app_settings")
}

model TeamThread {
  id            String   @id @default(cuid())
  key           String   @unique
  kind          String
  title         String?
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  lastPreview   String   @default("") @map("last_preview")
  createdAt     DateTime @default(now()) @map("created_at")

  members  TeamThreadMember[]
  messages TeamChatMessage[]

  @@map("team_threads")
}

model TeamThreadMember {
  id         String   @id @default(cuid())
  threadId   String   @map("thread_id")
  userId     String   @map("user_id")
  lastReadAt DateTime @default(now()) @map("last_read_at")
  joinedAt   DateTime @default(now()) @map("joined_at")

  thread TeamThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("team_thread_members")
}

model TeamChatMessage {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  senderId  String?  @map("sender_id")
  content   String
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  thread TeamThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@map("team_chat_messages")
}
